# Dependencies
node_modules

# Build output
dist
dist-ssr

# Secrets. VITE_ vars are inlined into the built bundle, so this file
# must never be committed.
.env
.env.local
.env.*.local

# Machine-specific Claude Code permission grants. The shared config belongs in
# .claude/settings.json instead.
.claude/settings.local.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor and OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python bytecode (vendored .claude skills)
__pycache__/
*.pyc

# Vendored third-party Claude Code skills. Reinstallable, not part of the app.
.claude/skills/

# Voice comparison clips from "npm run voices -- --samples". Not part of the app.
/voice-samples/
